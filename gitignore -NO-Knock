# IMPORTANT: Files you MAY want to track (comment out if needed)
# ============================================================================

# .gitkeep - Keep empty directories
# .editorconfig - Share editor settings across team
# .prettierrc - Share formatting rules
# .eslintrc - Share linting rules
# .env.example - Template for environment variables (TRACK THIS, not .env)
# package-lock.json - For Node.js production (consider tracking)
# poetry.lock - For Python production (consider tracking)
# requirements.txt - Python dependencies (TRACK THIS)
# .gitattributes - For git settings

